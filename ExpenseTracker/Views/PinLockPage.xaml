<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.ViewModels"
             x:Class="ExpenseTracker.Views.PinLockPage"
             x:DataType="vm:PinLockViewModel"
             Title="App Locked">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="24" Padding="30">

        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
            <Label Text="Expense Tracker Locked" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
            <Label Text="Authenticate using your device PIN or biometrics to unlock" FontSize="Small" TextColor="Gray" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Button Text="Unlock Now" 
                Command="{Binding AuthenticateCommand}" 
                BackgroundColor="#2E7D32" 
                TextColor="White" 
                FontAttributes="Bold" 
                CornerRadius="10" 
                HeightRequest="48" 
                WidthRequest="200" />

        <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="Caption" HorizontalTextAlignment="Center" />

    </VerticalStackLayout>
</ContentPage>