<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.ViewModels"
             x:Class="ExpenseTracker.Views.AddExpensePage"
             x:DataType="vm:AddExpenseViewModel"
             Title="Edit Expense">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Edit Expense" FontSize="Large" FontAttributes="Bold" />

            <Label Text="Amount" FontSize="Caption" TextColor="Gray" />
            <Entry Placeholder="Amount" Keyboard="Numeric" Text="{Binding AmountText}" />

            <!-- 🎯 ADDED: Transaction Type Selection (Debit / Credit) -->
            <Label Text="Transaction Type" FontSize="Caption" TextColor="Gray" />
            <Picker Title="Select Transaction Type" 
                    ItemsSource="{Binding TransactionTypes}" 
                    SelectedItem="{Binding SelectedTransactionType}" />

            <Label Text="Category" FontSize="Caption" TextColor="Gray" />
            <Picker Title="Category" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCategory}" />

            <Label Text="Payment Method" FontSize="Caption" TextColor="Gray" />
            <Picker Title="Payment Method" ItemsSource="{Binding PaymentMethods}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedPaymentMethod}" />

            <Label Text="Date" FontSize="Caption" TextColor="Gray" />
            <DatePicker Date="{Binding Date}" />

            <Label Text="Notes" FontSize="Caption" TextColor="Gray" />
            <Editor HeightRequest="100" Placeholder="Notes" Text="{Binding Note}" />

            <!-- Action Buttons Grid Configuration -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">

                <!-- Cancel Button -->
                <Button Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="LightGray"
                        TextColor="Black" />

                <!-- Save/Confirm Button -->
                <Button Grid.Column="1"
                        Text="Save Changes"
                        Command="{Binding SaveExpenseCommand}" />

            </Grid>

            <Label Text="{Binding StatusMessage}" TextColor="Green" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>