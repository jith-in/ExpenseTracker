<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Models"
             x:Class="ExpenseTracker.Views.ReportsPage"
             x:DataType="vm:ReportsViewModel"
             Title="Current Period Report">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Transaction Period Report" FontSize="Large" FontAttributes="Bold" />
            <Label Text="{Binding PeriodLabel}" FontSize="Small" TextColor="Gray" />

            <!-- ================= EXPENSES (DEBITS) TILE ================= -->
            <Frame BackgroundColor="#2D1F1F" CornerRadius="12" Padding="16" HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleExpensesCommand}" />
                </Frame.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Expenses (Debits)" FontSize="Medium" FontAttributes="Bold" TextColor="Red" VerticalOptions="Center" />
                        <Label Text="{Binding TotalExpenses, StringFormat='₹{0:N2}'}" Grid.Column="1" FontSize="Medium" FontAttributes="Bold" TextColor="Red" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Tap to view itemized list" FontSize="Micro" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Itemized Expenses List -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExpenseTransactions}" IsVisible="{Binding IsExpensesListVisible}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Expense">
                        <Frame BackgroundColor="DarkSlateGray" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Category}" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding Note}" FontSize="Caption" TextColor="LightGray" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}" FontSize="Micro" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label Text="{Binding Amount, StringFormat='-₹{0:N2}'}" Grid.Column="1" TextColor="#FF6B6B" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ================= INCOME (CREDITS) TILE ================= -->
            <Frame BackgroundColor="#1F2D20" CornerRadius="12" Padding="16" HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleIncomeCommand}" />
                </Frame.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Income (Credits)" FontSize="Medium" FontAttributes="Bold" TextColor="Green" VerticalOptions="Center" />
                        <Label Text="{Binding TotalIncome, StringFormat='₹{0:N2}'}" Grid.Column="1" FontSize="Medium" FontAttributes="Bold" TextColor="Green" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Tap to view itemized list" FontSize="Micro" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Itemized Income List -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding IncomeTransactions}" IsVisible="{Binding IsIncomeListVisible}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Expense">
                        <Frame BackgroundColor="DarkSlateGray" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Category}" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding Note}" FontSize="Caption" TextColor="LightGray" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}" FontSize="Micro" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label Text="{Binding Amount, StringFormat='+₹{0:N2}'}" Grid.Column="1" TextColor="#51CF66" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}" TextColor="Red" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>